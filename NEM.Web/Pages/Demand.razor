@page "/inputs/demand"
@using NEM.Contracts
@using System.Globalization
@inject ArtifactLoader ArtifactLoader

<PageTitle>Operational demand</PageTitle>

<div class="demand-page">
    <PageHeader Eyebrow="Actual operational demand" Title="Demand">
        <ScopeContent>
            @if (_loadState.Status == ArtifactLoadStatus.Success)
            {
                <ScopeLine Region="@($"{_regionName} ({_regionCode})")"
                           Period="@ArtifactPeriod"
                           Resolution="@ResolutionLabel"
                           BaselineGlobal="true" />
            }
        </ScopeContent>
        <TrailingContent>
            @if (_loadState.Status == ArtifactLoadStatus.Success)
            {
                <div class="demand-controls">
                @if (_regionOptions.Count > 1)
                {
                    <MudSelect T="string"
                               Label="Region"
                               Value="_selectedRegion"
                               ValueChanged="OnRegionChanged"
                               Variant="Variant.Outlined"
                               Class="region-select">
                        @foreach (string region in _regionOptions)
                        {
                            <MudSelectItem T="string" Value="region">@RegionName(region) (@region)</MudSelectItem>
                        }
                    </MudSelect>
                }

                <MudSelect T="int"
                           Label="View"
                           Value="_selectedView"
                           ValueChanged="OnViewChanged"
                           Variant="Variant.Outlined"
                           Class="view-select">
                    <MudSelectItem T="int" Value="0">Full financial year</MudSelectItem>
                    <MudSelectItem T="int" Value="-1">Single day</MudSelectItem>
                    @foreach (MonthOption month in _months)
                    {
                        <MudSelectItem T="int" Value="month.Month">@month.Label</MudSelectItem>
                    }
                </MudSelect>

                @if (_selectedView == -1)
                {
                    <label class="date-field">
                        <span>Day</span>
                        <input type="date"
                               min="@_minimumDate"
                               max="@_maximumDate"
                               value="@_selectedDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                               @onchange="OnDateChanged" />
                    </label>
                }
                </div>
            }
        </TrailingContent>
    </PageHeader>

    <ArtifactLoadStateView State="_loadState">
        <MetricStrip Items="@DemandMetrics" AriaLabel="Selected demand period summary" />

        <div class="trace-context">
            <span>@_periodLabel</span>
            <span>@_rawPointCount half-hour intervals</span>
            <span>@_displayPointCount @_displayPointDescription</span>
        </div>

        <ChartFrame Heading="@_chartTitle" Description="@_chartDescription" Unit="MW">
            <MudChart ChartType="ChartType.Line"
                      ChartSeries="_series"
                      ChartLabels="_xAxisLabels"
                      Width="100%"
                      Height="500px" />
        </ChartFrame>
    </ArtifactLoadStateView>
</div>

@code {
    private ArtifactLoadState _loadState = ArtifactLoadState.Loading();
    private List<ChartSeries<double>> _series = [];
    private string[] _xAxisLabels = [];
    private int _rawPointCount;
    private int _displayPointCount;
    private string _regionCode = string.Empty;
    private string _regionName = string.Empty;
    private string _periodLabel = string.Empty;
    private string _chartTitle = string.Empty;
    private string _chartDescription = string.Empty;
    private string _displayPointDescription = string.Empty;
    private string _minimumDate = string.Empty;
    private string _maximumDate = string.Empty;
    private double _peakDemandMw;
    private double _meanDemandMw;
    private double _minimumDemandMw;
    private double _energyMegawattHours;
    private double[] _demandMw = [];
    private DateTimeOffset _periodStart;
    private DateTimeOffset _periodEnd;
    private TimeSpan _resolution;
    private int _selectedView;
    private DateTime _selectedDate;
    private List<MonthOption> _months = [];
    private List<string> _regionOptions = [];
    private Dictionary<string, string> _demandPathsByRegion = new(StringComparer.OrdinalIgnoreCase);
    private string _selectedRegion = string.Empty;

    private IReadOnlyList<MetricStripItem> DemandMetrics =>
    [
        new("Peak demand", _peakDemandMw.ToString("N0"), "MW"),
        new("Mean demand", _meanDemandMw.ToString("N0"), "MW"),
        new("Minimum demand", _minimumDemandMw.ToString("N0"), "MW"),
        new("Energy supplied", _energyMegawattHours.ToString("N0"), "MWh"),
    ];

    private string ArtifactPeriod => $"{_periodStart:dd MMM yyyy} to {_periodEnd.AddTicks(-1):dd MMM yyyy}";
    private string ResolutionLabel => $"{_resolution.TotalMinutes:N0}-minute intervals";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            ArtifactLoadResult<SystemDispatchOverviewDTO> overviewResult =
                await ArtifactLoader.LoadAsync<SystemDispatchOverviewDTO>("data/results-overview.json");
            if (overviewResult.IsSuccess)
            {
                if (!TryConfigureRegions(
                        overviewResult.Value!.RegionIds,
                        overviewResult.Value.DataSourcesByRegion,
                        out string? validationMessage))
                {
                    _loadState = ArtifactLoadState.InvalidData(validationMessage!);
                    return;
                }

                await LoadDemandAsync(_demandPathsByRegion[_selectedRegion], _selectedRegion);
                return;
            }

            _loadState = overviewResult.State;
        }
        catch (Exception exception)
        {
            _loadState = ArtifactLoadState.Failed($"Error loading demand data: {exception.Message}");
        }
    }

    private async Task OnRegionChanged(string region)
    {
        if (!_demandPathsByRegion.TryGetValue(region, out string? demandPath)
            || string.Equals(region, _selectedRegion, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _selectedRegion = region;
        _loadState = ArtifactLoadState.Loading();
        await LoadDemandAsync(demandPath, region);
    }

    private async Task LoadDemandAsync(string path, string expectedRegion)
    {
        ArtifactLoadResult<ModelInputOutputDTO> loadResult =
            await ArtifactLoader.LoadAsync<ModelInputOutputDTO>(path);
        if (!loadResult.IsSuccess)
        {
            _loadState = loadResult.State;
            return;
        }

        ModelInputOutputDTO result = loadResult.Value!;
        if (!string.Equals(result.Scenario.Region, expectedRegion, StringComparison.OrdinalIgnoreCase))
        {
            _loadState = ArtifactLoadState.InvalidData(
                $"Demand artifact region {result.Scenario.Region} does not match selected region {expectedRegion}.");
            return;
        }

        double[]? demandMw = result.DataSeries.DemandMw;
        DateTimeOffset periodStart = result.Scenario.PeriodStart;
        DateTimeOffset periodEnd = result.Scenario.PeriodEnd;
        TimeSpan resolution = result.Scenario.Resolution;
        if (demandMw is null
            || demandMw.Length == 0
            || resolution <= TimeSpan.Zero
            || periodEnd <= periodStart
            || (periodEnd - periodStart).Ticks % resolution.Ticks != 0
            || (periodEnd - periodStart).Ticks / resolution.Ticks != demandMw.Length)
        {
            _loadState = ArtifactLoadState.InvalidData("Operational-demand timestamps and values are empty or misaligned.");
            return;
        }

        _demandMw = demandMw;
        _periodStart = periodStart;
        _periodEnd = periodEnd;
        _resolution = resolution;
        _selectedDate = periodStart.Date;
        _minimumDate = periodStart.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        _maximumDate = periodEnd.AddTicks(-1).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        _regionCode = result.Scenario.Region.ToUpperInvariant();
        _regionName = RegionName(_regionCode);
        _months = BuildMonthOptions(periodStart, periodEnd);
        BuildChart();
        _loadState = loadResult.State;
    }

    private bool TryConfigureRegions(
        string[] regionIds,
        Dictionary<string, DispatchSourcesDTO> dataSourcesByRegion,
        out string? validationMessage)
    {
        validationMessage = null;
        if (regionIds is null || regionIds.Length == 0)
        {
            validationMessage = "System dispatch results do not define any regions.";
            return false;
        }

        if (dataSourcesByRegion is null)
        {
            validationMessage = "System dispatch results do not define regional data sources.";
            return false;
        }

        var pathsByRegion = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (string? regionId in regionIds)
        {
            if (string.IsNullOrWhiteSpace(regionId)
            || !dataSourcesByRegion.TryGetValue(regionId, out DispatchSourcesDTO? sources)
                || sources?.DemandInput is null
                || !TryGetDataArtifactPath(sources.DemandInput.FileName, out string? demandPath))
            {
                validationMessage = "System dispatch results contain a region without a valid demand artifact reference.";
                return false;
            }

            pathsByRegion[regionId.ToUpperInvariant()] = demandPath;
        }

        _regionOptions = pathsByRegion.Keys.Order(StringComparer.Ordinal).ToList();
        _demandPathsByRegion = pathsByRegion;
        _selectedRegion = _regionOptions[0];
        return true;
    }

    private static bool TryGetDataArtifactPath(string fileName, out string path)
    {
        path = string.Empty;
        if (string.IsNullOrWhiteSpace(fileName))
        {
            return false;
        }

        string normalized = fileName.Replace('\\', '/').TrimStart('/');
        if (normalized.StartsWith("data/", StringComparison.OrdinalIgnoreCase))
        {
            normalized = normalized["data/".Length..];
        }

        if (normalized.Length == 0
            || normalized.Split('/').Any(segment => segment is "" or "." or ".."))
        {
            return false;
        }

        path = $"data/{normalized}";
        return true;
    }

    private void OnViewChanged(int view)
    {
        _selectedView = view;
        BuildChart();
    }

    private void OnDateChanged(ChangeEventArgs args)
    {
        if (DateTime.TryParseExact(
            args.Value?.ToString(),
            "yyyy-MM-dd",
            CultureInfo.InvariantCulture,
            DateTimeStyles.None,
            out DateTime selectedDate)
            && selectedDate >= _periodStart.Date
            && selectedDate < _periodEnd.Date)
        {
            _selectedDate = selectedDate;
            BuildChart();
        }
    }

    private void BuildChart()
    {
        int[] selectedIndexes = Enumerable.Range(0, _demandMw.Length)
            .Where(IsSelected)
            .ToArray();

        _rawPointCount = selectedIndexes.Length;
        _peakDemandMw = selectedIndexes.Max(index => _demandMw[index]);
        _meanDemandMw = selectedIndexes.Average(index => _demandMw[index]);
        _minimumDemandMw = selectedIndexes.Min(index => _demandMw[index]);
        _energyMegawattHours = selectedIndexes.Sum(index => _demandMw[index]) * _resolution.TotalHours;
        DateTimeOffset selectedStart = InstantAt(selectedIndexes[0]);
        DateTimeOffset selectedEnd = InstantAt(selectedIndexes[^1]) + _resolution;
        _periodLabel = _selectedView == -1
            ? selectedStart.ToString("dddd, dd MMMM yyyy")
            : $"{selectedStart:dd MMM yyyy} to {selectedEnd.AddTicks(-1):dd MMM yyyy}";

        int targetDisplayPoints = _selectedView == -1 ? selectedIndexes.Length : 600;
        int bucketSize = Math.Max(1, (int)Math.Ceiling((double)_rawPointCount / targetDisplayPoints));
        var chartData = new List<double>();
        var timestamps = new List<DateTimeOffset>();

        for (int bucketStart = 0; bucketStart < _rawPointCount; bucketStart += bucketSize)
        {
            int bucketEnd = Math.Min(bucketStart + bucketSize, _rawPointCount);
            double bucketAverage = selectedIndexes[bucketStart..bucketEnd]
                .Average(index => _demandMw[index]);
            chartData.Add(bucketAverage);
            timestamps.Add(InstantAt(selectedIndexes[bucketStart]));
        }

        _displayPointCount = chartData.Count;
        _displayPointDescription = _selectedView == -1 ? "displayed values" : "displayed averages";
        _chartTitle = _selectedView == -1 ? "Demand through the day" : "Demand profile";
        _chartDescription = _selectedView == -1
            ? "Every half-hour interval is shown in NEM market time (UTC+10)"
            : "Contiguous half-hour intervals are averaged into display buckets";
        _xAxisLabels = BuildLabels(timestamps);
        _series =
        [
            new ChartSeries<double>
            {
                Name = _selectedView == -1
                    ? "Operational demand (MW)"
                    : "Average operational demand (MW)",
                Data = chartData.ToArray(),
            },
        ];
    }

    private bool IsSelected(int index)
    {
        DateTimeOffset instant = InstantAt(index);
        return _selectedView switch
        {
            -1 => instant.Date == _selectedDate.Date,
            0 => true,
            _ => instant.Month == _selectedView,
        };
    }

    private string[] BuildLabels(IReadOnlyList<DateTimeOffset> timestamps)
    {
        const int MaximumLabelCount = 7;
        int labelCount = Math.Min(MaximumLabelCount, timestamps.Count);
        int labelStride = Math.Max(1, timestamps.Count / labelCount);
        var labels = new string[timestamps.Count];
        string? previousLabel = null;
        for (int index = 0; index < timestamps.Count; index++)
        {
            if (index % labelStride == 0 || index == timestamps.Count - 1)
            {
                string label = timestamps[index].ToString(_selectedView switch
                {
                    -1 => "HH:mm",
                    0 => "MMM yyyy",
                    _ => "dd MMM",
                });
                labels[index] = label == previousLabel ? string.Empty : label;
                previousLabel = label;
            }
            else
            {
                labels[index] = string.Empty;
            }
        }

        return labels;
    }

    private DateTimeOffset InstantAt(int index) =>
        _periodStart.AddTicks(_resolution.Ticks * index);

    private static List<MonthOption> BuildMonthOptions(
        DateTimeOffset periodStart,
        DateTimeOffset periodEnd)
    {
        var months = new List<MonthOption>();
        var monthStart = new DateTimeOffset(
            periodStart.Year,
            periodStart.Month,
            1,
            0,
            0,
            0,
            periodStart.Offset);
        while (monthStart < periodEnd)
        {
            months.Add(new MonthOption(monthStart.Month, monthStart.ToString("MMMM yyyy")));
            monthStart = monthStart.AddMonths(1);
        }

        return months;
    }

    private static string RegionName(string regionCode) => regionCode switch
    {
        "NSW1" => "New South Wales",
        "QLD1" => "Queensland",
        "SA1" => "South Australia",
        "TAS1" => "Tasmania",
        "VIC1" => "Victoria",
        _ => regionCode,
    };

    private sealed record MonthOption(int Month, string Label);
}